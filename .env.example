# Required in production. Use a long random password.
APP_PASSWORD=replace-with-a-long-random-password

# Required in production. Must be base64 for exactly 32 random bytes.
# Example shape only, do not use this value:
SESSION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Optional. If omitted, SESSION_ENCRYPTION_KEY is also used to sign cookies.
COOKIE_SECRET=replace-with-another-long-random-secret

PORT=3000
DATA_DIR=/data
NODE_ENV=production
